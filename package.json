{
  "name": "vpn-poppy",
  "version": "0.1.3",
  "private": true,
  "description": "A personal VPN on the fly in your own AWS — one-click WireGuard endpoints, no SSH, teardown when you're done. An AgentsPoppy extension.",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "npm run build -w @vpnpoppy/frontend",
    "validate-manifest": "node scripts/validate-manifest.mjs",
    "assess-permissions": "node scripts/assess-permissions.mjs",
    "install-dev": "node \"${AGENTSPOPPY_DIR:-../agentspoppy}/scripts/install-dev-extension.mjs\" --src . --frontend frontend/dist --backend backend/index.cjs",
    "certify": "npm --prefix \"${AGENTSPOPPY_DIR:-../agentspoppy}\" run certify -- --extension \"$INIT_CWD\" --yes",
    "build:backend": "node scripts/build-backend-bundle.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  },
  "license": "PolyForm-Shield-1.0.0",
  "optionalDependencies": {
    "@esbuild/darwin-arm64": "^0.24.0",
    "@esbuild/darwin-x64": "^0.24.2",
    "@rollup/rollup-darwin-arm64": "^4.62.2",
    "@rollup/rollup-darwin-x64": "^4.62.2"
  }
}
